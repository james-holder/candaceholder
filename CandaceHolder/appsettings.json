{
  // ── Admin access ────────────────────────────────────────────────────────
  // Email address that gets access to /Admin. Change this to your own address.
  "AdminEmail": "jaholder78@gmail.com",

  // ── Stripe (billing — subscriptions + one-time report packs) ───────────
  // Sign up at https://dashboard.stripe.com/register (or use an existing
  // account). Everything below is blank by default — until SecretKey is
  // filled in, BillingController.Checkout returns a friendly "billing isn't
  // set up yet" error instead of crashing. See docs/pricing-refresh-punchlist.md
  // Workstream A3 for the full setup checklist (creating the 5 products/prices,
  // pointing a webhook at this app, etc.).
  //
  // 1. Dashboard → Developers → API keys → copy the Secret key (starts
  //    "sk_test_..." while testing, "sk_live_..." once you're ready for real
  //    charges) into SecretKey, and the Publishable key into PublishableKey
  //    (publishable key isn't currently used server-side but kept here so
  //    it's in one place if a client-side Stripe.js flow is ever added).
  // 2. Dashboard → Product catalog → add 4 products matching
  //    Services/PricingCatalog.cs exactly (that file, not this comment, is
  //    the source of truth for prices/allotments — see docs/pricing-refresh-punchlist.md):
  //      - Starter:  $14.99 recurring monthly     → paste Price ID into StarterPriceId
  //      - Pro:      $39.99 recurring monthly, unlimited reports → ProPriceId
  //      - Top-up:   $5.99   one-time (3 reports)  → TopupPriceId
  //      - 50-pack:  $59.99  one-time (50 reports)  → Pack50PriceId
  //    (Price IDs look like "price_1AbCdE..." — not the Product ID, which
  //    starts "prod_" and won't work here.)
  //    100-pack removed 2026-07-23 (redundant now that Pro is unlimited) —
  //    if a Pack100PriceId is still configured anywhere, it's inert; the
  //    100-pack Stripe Product/Price can be archived (not deleted) in the
  //    Dashboard. Existing customers who already own purchase_pack100
  //    credits keep them (never expire, never migrated).
  //    Stripe Prices are immutable: if a Price already exists at an old
  //    amount (appsettings.Development.json currently has real test-mode
  //    Price IDs for Starter/Pro/Topup/Pack50, still pointing at pre-2026-07-16
  //    revision amounts), create a *new* Price object rather than editing it,
  //    and point the matching *PriceId at the new one. Existing subscribers
  //    should stay on the old Price IDs (grandfathered) rather than being
  //    migrated to the new ones.
  // 3. Dashboard → Developers → Webhooks → add endpoint
  //    https://yourdomain/Billing/Webhook, select events: checkout.session.completed,
  //    invoice.paid, customer.subscription.deleted — then copy the
  //    "Signing secret" (starts "whsec_...") into WebhookSecret.
  "Stripe": {
    "SecretKey":       "",
    "PublishableKey":  "",
    "WebhookSecret":   "",
    "StarterPriceId":  "",
    "ProPriceId":      "",
    "TopupPriceId":    "",
    "Pack50PriceId":   ""
  },

  // ── DNC.com (National Do Not Call Registry scrub) ──────────────────────
  // Sign up at https://www.dnc.com — ~$99/year flat fee for TX+OK area codes.
  // API docs: https://www.dnc.com/api  — GET /v2/scrub?phone={number}&apiKey={key}
  // Leave ApiKey blank to skip DNC scrubbing (numbers will still be checked
  // against the internal suppression list, but NOT the federal registry).
  "DncCom": {
    "ApiKey": ""
  },

  // ── Twilio (Lead Gen SMS) ───────────────────────────────────────────────
  // Sign up at https://twilio.com — free trial includes a phone number + credits.
  // AccountSid and AuthToken are on your Twilio Console dashboard.
  // FromNumber must be a Twilio number in E.164 format: +1XXXXXXXXXX
  "Twilio": {
    "AccountSid":  "",
    "AuthToken":   "",
    "FromNumber":  ""
  },

  // ── Feature flags ───────────────────────────────────────────────────────
  "FeatureFlags": {
    "HailSwathPolygons": false,  // convex-hull size-banded swath overlay in Storm Explorer
    "AlertsEnabled": false,      // master switch — Storm Alerts isn't being rolled out yet (2026-07-23).
                                 // Hides the nav link everywhere and redirects /Alerts itself to "/".
                                 // The underlying watched-areas feature/data/API endpoints are untouched —
                                 // only the entry points are gated, same pattern as EnrichmentEnabled below.
    "EnrichmentEnabled": false,  // master switch — flip to true to re-enable owner-contact enrichment
    "MeshSwaths": true,          // Phase 2 radar-derived MRMS MESH swath — ON. Unverified against
                                 // live data as of 2026-07-13; use /RoofHealth/MeshDebug to check
                                 // real behavior after deploy. See docs/mesh-phase2-handoff.md.
    "ReportCreditsEnabled": true // gates PDF hail-report generation on report-credit balance
                                 // (see ReportCreditService, docs/pricing-refresh-punchlist.md).
                                 // Turned ON 2026-07-14. Any org with a 0 report-credit balance
                                 // (all orgs created before this feature — no backfill has run)
                                 // will get a 402 on /Leads/{id}/Report until granted credits via
                                 // /Admin. Stripe checkout (Workstream A3) still doesn't exist, so
                                 // an org that runs out has no self-serve way to buy more yet —
                                 // /Admin is the only path to grant credits right now.
  },

  // ── MESH (radar-derived hail swath, Phase 2) ───────────────────────────
  // Requires gdal_translate + gdal_contour on PATH (see Dockerfile). Data is
  // free/public (NOAA AWS OpenData + IEM MTArchive) — no API key needed.
  // Leave paths as-is unless GDAL is installed somewhere non-standard.
  "Mesh": {
    "CacheDir":              "", // blank = data/mesh-cache under the app's data volume
    "AwsBaseUrl":            "https://noaa-mrms-pds.s3.amazonaws.com",
    "IemArchiveBaseUrl":     "https://mtarchive.geol.iastate.edu",
    "GdalTranslatePath":     "gdal_translate",
    "GdalContourPath":       "gdal_contour",
    "ProcessTimeoutSeconds": 90
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ── Google Maps API key ────────────────────────────────────────────────
  // Used server-side (geocoding, reverse-geocode grid) and in the frontend map.
  // Restriction: set to "None" (or IP-restricted) — HTTP-referrer keys won't
  // work for server-side calls.
  "GoogleMaps": {
    "ApiKey": ""
  },

  // ── MapTiler API key ───────────────────────────────────────────────────
  // Sign up free at https://www.maptiler.com — 100k map loads/month, hard stop
  // (no surprise bills). Used for the Storm Explorer basemap (street/base layer).
  // Keep Esri satellite as the satellite toggle; MapTiler replaces CARTO dark.
  "MapTiler": {
    "ApiKey": ""
  },

  // ── Free data source API keys ──────────────────────────────────────────
  // Regrid (property owner names): sign up free at https://app.regrid.com
  //   Free Starter plan = 25 lookups/day. Paste your token below.
  //   Leave blank to skip owner-name enrichment (app still works fully).
  "Regrid": {
    "Token": ""
  },

  // ── Tomorrow.io (hail and weather history) ────────────────────────────
  // Sign up free at https://app.tomorrow.io — 500 req/day free, 5yr history.
  // Fills the NOAA 120-day radar lag gap with near-real-time storm data.
  // DailyCallCap: hard system-wide cap RealDataService enforces on its own 2-
  // calls-per-report Tomorrow.io usage, on top of the caching added 2026-07-16.
  // Free tier is 500 calls/day with no published overage rate (quote-based only
  // past it) — capped at 480 here to leave a small buffer rather than ride the
  // line exactly. Once the cap is hit for the day, reports still generate; they
  // just fall back to NOAA/LSR/StormEvents/MESH without the Tomorrow.io fill.
  "TomorrowIo": {
    "ApiKey": "",
    "DailyCallCap": 480
  },

  // ── Auth providers ────────────────────────────────────────────────────────
  // Leave blank during demo phase — no login is required yet.
  // Fill in before going live to enable Google / Microsoft sign-in.
  //
  // Google:    https://console.cloud.google.com  → APIs & Services → Credentials
  //            Authorised redirect URI: https://yourdomain/signin-google
  //
  // Microsoft: https://portal.azure.com  → Azure Active Directory → App registrations
  //            Redirect URI: https://yourdomain/signin-microsoft

  // ── BatchSkipTracing (contact enrichment) ─────────────────────────────────
  // Sign up at https://batchskiptracing.com — pay-per-record, ~$0.12/lookup
  // Paste your API key below to enable the lightning bolt button on each lead.
  "BatchSkipTracing": {
    "ApiKey": ""
  },

  // ── Whitepages Pro (contact enrichment — phone + email) ───────────────────
  // Sign up at https://pro.whitepages.com — ~$0.22/record on the 1000/mo plan
  // Paste your API key below. When set, the Enrich button will call Whitepages
  // after Regrid to fill in phone + email.
  "WhitepagesPro": {
    "ApiKey": ""
  },

  // ── Email / SMTP (storm alert emails) ────────────────────────────────────
  // Works with any SMTP server. Port 587 = STARTTLS, 465 = SSL, 25 = plain.
  // Leave SmtpHost blank to disable email sending (app still works fully).
  "Email": {
    "SmtpHost": "",
    "SmtpPort": "587",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Candace Holder"
  },

  "Auth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
  // ── Notes on other data sources ────────────────────────────────────────
  // OpenStreetMap Overpass API (real nearby addresses):  No key needed.
  // NOAA SWDI hail API        (real storm history):      No key needed.
  // Google Maps               (geocoding + autocomplete): Already configured
  //                            in RoofHealthController.cs and Index.cshtml.
}
