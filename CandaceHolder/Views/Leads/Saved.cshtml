@{
    Layout = null;
}
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Saved Leads — Candace Holder</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-config-app.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/saved-leads.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="min-h-screen">

<!-- Toast -->
<div id="toast">
    <i id="toastIcon" class="fa-solid fa-circle-check"></i>
    <span id="toastMsg"></span>
</div>

<!-- ══════════════════════════════════════════════════════════════
     HEADER
══════════════════════════════════════════════════════════════ -->
<header class="sticky top-0 z-50 bg-navy border-b border-slate-700/60 shadow-lg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">

        <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
            <div class="w-8 h-8 brand-logo rounded-lg flex items-center justify-center shadow">
                <i class="fa-solid fa-address-book text-slate-50 text-sm"></i>
            </div>
            <span class="text-lg font-bold tracking-tight">
                Candace <span class="brand-text">Holder</span>
            </span>
        </a>

        <nav class="hidden lg:flex items-center gap-6 text-sm text-slate-400">
            <a href="/" class="hover:text-brand transition-colors">
                <i class="fa-solid fa-magnifying-glass mr-1 text-xs"></i>Search
            </a>
            <a href="/Leads/Saved" class="text-slate-50 font-semibold">
                <i class="fa-solid fa-bookmark mr-1 text-brand text-xs"></i>Saved Leads
            </a>
            <a href="/Dashboard" class="hover:text-brand transition-colors">Dashboard</a>
            <a href="/Help" class="hover:text-brand transition-colors">
                <i class="fa-solid fa-circle-question mr-1 text-xs"></i>Help
            </a>
            @if (User.FindFirst("admin_role")?.Value is "admin" or "super_admin" ||
                 string.Equals(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "", Configuration["AdminEmail"], System.StringComparison.OrdinalIgnoreCase)) {
                <a href="/Admin" class="text-orange-600 hover:text-orange-700 transition-colors text-xs">
                    <i class="fa-solid fa-shield-halved mr-1"></i>Admin
                </a>
            }
            <span class="text-slate-600">|</span>
            @await Html.PartialAsync("_AccountMenu")
        </nav>

        <!-- Hamburger (mobile only) -->
        <button id="mobileMenuBtn" onclick="toggleMobileMenu()"
            class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-brand hover:bg-slate-700/60 transition-colors">
            <i id="mobileMenuIcon" class="fa-solid fa-bars text-lg"></i>
        </button>
    </div>

    <!-- Mobile nav drawer -->
    <div id="mobileMenu" class="hidden lg:hidden absolute top-full left-0 right-0 bg-navy border-t border-slate-700/60 shadow-2xl z-50 px-4 py-3 flex flex-col gap-1">
        <a href="/" class="flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:text-brand hover:bg-slate-700/60 transition-colors text-sm">
            <i class="fa-solid fa-magnifying-glass w-4 text-center text-xs"></i>Search
        </a>
        <a href="/Leads/Saved" class="flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-700/60 text-slate-50 font-semibold text-sm">
            <i class="fa-solid fa-bookmark text-brand w-4 text-center text-xs"></i>Saved Leads
        </a>
        <a href="/Dashboard" class="flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:text-brand hover:bg-slate-700/60 transition-colors text-sm">
            <i class="fa-solid fa-chart-bar w-4 text-center text-xs"></i>Dashboard
        </a>
        <a href="/Help" class="flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:text-brand hover:bg-slate-700/60 transition-colors text-sm">
            <i class="fa-solid fa-circle-question w-4 text-center text-xs"></i>Help
        </a>
        <div class="border-t border-slate-700/60 my-1"></div>
        @await Html.PartialAsync("_AccountMenuMobile")
    </div>
</header>

<!-- ══════════════════════════════════════════════════════════════
     PAGE HERO
══════════════════════════════════════════════════════════════ -->
<div class="border-b border-slate-700/40 hero-band">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-50 flex items-center gap-2">
                <i class="fa-solid fa-bookmark text-brand"></i>
                Saved Leads
                <span id="heroCount" class="text-base font-normal text-slate-400 ml-1"></span>
            </h1>
            <p class="text-slate-400 text-sm mt-0.5">Skip trace saved addresses to get owner names, phones, and emails.</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="exportCSV()"
                class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-700 hover:bg-slate-600
                       border border-slate-600 text-xs font-semibold text-slate-200 transition shadow">
                <i class="fa-solid fa-file-csv text-brand"></i>Export CSV
            </button>
            <a href="/"
                class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand hover:bg-brand-dark
                       text-white text-xs font-semibold transition shadow">
                <i class="fa-solid fa-plus"></i>Find Addresses
            </a>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     LEAD TABS
══════════════════════════════════════════════════════════════ -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5 pb-1 overflow-x-auto">
    <div class="inline-flex min-w-full sm:min-w-0 rounded-xl bg-slate-800 border border-slate-700 p-1 gap-1">
        <button id="tabPipeline" onclick="switchLeadTab('pipeline')"
            class="lead-tab lead-tab-active flex-1 flex items-center justify-center gap-1.5 px-3 sm:px-5 py-2.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap">
            <i class="fa-solid fa-filter text-sky-600"></i>
            Active
            <span id="tabPipelineCount" class="px-2 py-0.5 rounded-full bg-slate-700/80 text-xs font-bold text-slate-300"></span>
        </button>
        <button id="tabClosed" onclick="switchLeadTab('closed')"
            class="lead-tab flex-1 flex items-center justify-center gap-1.5 px-3 sm:px-5 py-2.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap">
            <i class="fa-solid fa-flag-checkered text-slate-400"></i>
            Closed
            <span id="tabClosedCount" class="px-2 py-0.5 rounded-full bg-slate-700/80 text-xs font-bold text-slate-300"></span>
        </button>
        <button id="tabArchived" onclick="switchLeadTab('archived')"
            class="lead-tab flex-1 flex items-center justify-center gap-1.5 px-3 sm:px-5 py-2.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap">
            <i class="fa-solid fa-box-archive text-slate-400"></i>
            <span class="hidden sm:inline">Archived</span>
            <span class="sm:hidden">Archive</span>
            <span id="tabArchivedCount" class="px-2 py-0.5 rounded-full bg-slate-700/80 text-xs font-bold text-slate-300"></span>
        </button>
    </div>
</div>

<!-- Bulk action toolbar (appears when rows selected) -->
<div id="bulkToolbar" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
    <div class="flex flex-wrap items-center gap-3 bg-slate-800 border border-orange-500/40 rounded-xl px-4 py-2.5 shadow-lg">
        <span class="text-slate-200 text-sm font-semibold">
            <span id="selectedCount">0</span> lead<span id="selectedCountPlural">s</span> selected
        </span>
        <div class="flex-1"></div>
        <button id="btnBulkEnrich" onclick="bulkEnrich()"
            class="hidden flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold transition">
            <i class="fa-solid fa-magnifying-glass-dollar"></i>Skip Trace
        </button>
        <button id="btnBulkExport" onclick="bulkExport()"
            class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 text-xs font-semibold transition">
            <i class="fa-solid fa-file-csv text-brand"></i>Export
        </button>
        <button id="btnBulkDelete" onclick="bulkDelete()"
            class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-red-500/15 hover:bg-red-500/30 border border-red-500/40 text-red-600 text-xs font-semibold transition">
            <i class="fa-solid fa-box-archive"></i>Archive
        </button>
        <button onclick="clearSelection()"
            class="text-slate-400 hover:text-slate-200 text-xs font-semibold underline-offset-2 hover:underline transition">
            Clear selection
        </button>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     LEADS
══════════════════════════════════════════════════════════════ -->
<div id="panelLeads" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Filter / search bar -->
    <div class="mb-4 space-y-2 sm:space-y-0 sm:flex sm:flex-wrap sm:items-center sm:gap-3">

        <!-- Skip-trace filter pills — scroll horizontally on mobile -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5" style="-ms-overflow-style:none;scrollbar-width:none;">
            <button onclick="setFilter('all')" data-f="all"
                class="filter-btn active flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 border border-slate-600">
                All <span id="fAll" class="ml-1 opacity-60"></span>
            </button>
            <button onclick="setFilter('untraced')" data-f="untraced"
                class="filter-btn flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 border border-slate-600">
                <span class="text-orange-600">● Not traced</span> <span id="fUntraced" class="ml-1 opacity-60"></span>
            </button>
            <button onclick="setFilter('traced')" data-f="traced"
                class="filter-btn flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 border border-slate-600">
                <span class="text-green-600">● Traced</span> <span id="fTraced" class="ml-1 opacity-60"></span>
            </button>
        </div>

        <!-- Search — full width on mobile -->
        <div class="relative sm:flex-1 sm:min-w-[200px] sm:max-w-sm sm:ml-auto">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
            <input id="searchInput" type="text" placeholder="Search address, owner, phone…"
                oninput="renderTable()"
                class="w-full pl-8 pr-3 py-2 rounded-lg bg-slate-800 border border-slate-600 text-slate-50 text-xs
                       placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition" />
        </div>
    </div>

    <!-- Mobile card list (< md) -->
    <div id="mobileCards" class="md:hidden space-y-3 mb-4"></div>

    <!-- Desktop table (md+) -->
    <div class="hidden md:block rounded-2xl border border-slate-700/60 shadow-xl bg-slate-800/40 overflow-hidden">
        <div class="overflow-x-auto">
            <table id="leadsTable" class="w-full border-collapse">
                <thead>
                    <tr>
                        <th id="thCheckbox" class="w-8 text-center" style="cursor:default">
                            <input type="checkbox" id="selectAll" class="accent-pink-600 w-4 h-4 cursor-pointer" onchange="toggleSelectAll(this)" title="Select all" />
                        </th>
                        <th onclick="sortBy('address')"    class="text-left" style="min-width:180px"><span class="sort-icon">Address</span></th>
                        <th onclick="sortBy('ownerName')"  class="text-left" style="min-width:130px"><span class="sort-icon">Owner</span></th>
                        <th onclick="sortBy('ownerPhone')" class="text-left" style="min-width:120px"><span class="sort-icon">Phone</span></th>
                        <th onclick="sortBy('ownerEmail')" class="text-left hidden lg:table-cell" style="min-width:140px"><span class="sort-icon">Email</span></th>
                        <th onclick="sortBy('status')"     class="text-left" style="min-width:120px"><span class="sort-icon">Status</span></th>
                        <th class="text-center sticky-actions" style="cursor:default; min-width:150px">Actions</th>
                    </tr>
                </thead>
                <tbody id="leadsBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Loading state -->
    <div id="leadsLoading" class="flex items-center justify-center py-14 gap-3 text-slate-400 text-sm">
        <svg class="spinner w-5 h-5" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"
                    stroke-dasharray="60" stroke-dashoffset="20" />
        </svg>
        Loading leads…
    </div>

    <!-- Empty state -->
    <div id="leadsEmpty" class="hidden flex flex-col items-center justify-center py-16 text-slate-500 gap-2">
        <i class="fa-solid fa-bookmark text-4xl text-slate-700 mb-1"></i>
        <p class="font-semibold text-slate-400">No saved leads here</p>
        <p class="text-sm">Find addresses by search or on the map, then save the ones you want.</p>
        <a href="/" class="mt-3 px-4 py-2 rounded-lg bg-brand text-white text-xs font-semibold hover:bg-brand-dark transition">
            <i class="fa-solid fa-magnifying-glass mr-1"></i>Find Addresses
        </a>
    </div>

    <!-- No-match (filter/search) -->
    <div id="leadsNoMatch" class="hidden flex flex-col items-center justify-center py-14 text-slate-500 gap-2">
        <i class="fa-solid fa-filter text-3xl text-slate-700"></i>
        <p class="text-sm">No leads match this filter or search.</p>
    </div>
</div>

<footer class="mt-12 border-t border-slate-700/60 bg-slate-900/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
        <div class="flex items-center gap-2">
            <div class="w-5 h-5 brand-logo rounded flex items-center justify-center">
                <i class="fa-solid fa-address-book text-slate-50 text-xs"></i>
            </div>
            <span>Candace Holder &copy; 2026</span>
        </div>
        <span>Owner info is editable &mdash; click the pencil icon on any row</span>
    </div>
</footer>

<script src="~/js/saved-leads.js" asp-append-version="true"></script>
</body>
</html>
