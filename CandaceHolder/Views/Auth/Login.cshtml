@{
    Layout = null;
    var returnUrl        = ViewData["ReturnUrl"]        as string ?? "/";
    var googleEnabled    = ViewData["GoogleEnabled"]    is true;
    var microsoftEnabled = ViewData["MicrosoftEnabled"] is true;
    var passwordEnabled  = ViewData["PasswordEnabled"]  is true;
    var loginError       = ViewData["LoginError"]       as string;
    var loginSuccess     = ViewData["LoginSuccess"]     as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Candace Holder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-config-app.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex items-center justify-center p-4">

<div class="w-full max-w-sm">

    <!-- Logo -->
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2.5 mb-4">
            <div class="w-10 h-10 brand-logo rounded-xl flex items-center justify-center shadow-lg">
                <i class="fa-solid fa-address-book text-slate-50"></i>
            </div>
            <span class="text-2xl font-extrabold text-slate-50 tracking-tight">
                Candace <span class="brand-text">Holder</span>
            </span>
        </div>
        <p class="text-slate-400 text-sm">Sign in to access your leads dashboard</p>
    </div>

    <!-- Card -->
    <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-8 shadow-2xl">

        <h2 class="text-slate-50 font-bold text-lg mb-6 text-center">Welcome back</h2>

        <div class="space-y-3">

            @if (googleEnabled)
            {
                <a href="/Auth/SignIn/Google?returnUrl=@Uri.EscapeDataString(returnUrl)"
                   class="btn-provider">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Continue with Google
                </a>
            }

            @if (microsoftEnabled)
            {
                <a href="/Auth/SignIn/Microsoft?returnUrl=@Uri.EscapeDataString(returnUrl)"
                   class="btn-provider">
                    <svg viewBox="0 0 23 23" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px">
                        <rect x="1"  y="1"  width="10" height="10" fill="#F25022"/>
                        <rect x="12" y="1"  width="10" height="10" fill="#7FBA00"/>
                        <rect x="1"  y="12" width="10" height="10" fill="#00A4EF"/>
                        <rect x="12" y="12" width="10" height="10" fill="#FFB900"/>
                    </svg>
                    Continue with Microsoft
                </a>
            }

            @if (passwordEnabled)
            {
                if (googleEnabled || microsoftEnabled)
                {
                    <div class="flex items-center gap-3 my-1">
                        <div class="flex-1 h-px bg-slate-700"></div>
                        <span class="text-slate-500 text-xs">or</span>
                        <div class="flex-1 h-px bg-slate-700"></div>
                    </div>
                }
                @if (loginSuccess != null)
                {
                    <div class="bg-green-500/10 border border-green-500/30 rounded-xl px-4 py-3 text-green-600 text-sm text-center">
                        <i class="fa-solid fa-circle-check mr-1"></i>@loginSuccess
                    </div>
                }
                @if (loginError != null)
                {
                    <div class="bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-3 text-red-600 text-sm text-center">
                        <i class="fa-solid fa-circle-exclamation mr-1"></i>@loginError
                    </div>
                }
                <form method="post" action="/Auth/Login?returnUrl=@Uri.EscapeDataString(returnUrl)" class="space-y-3">
                    <input type="email" name="email" placeholder="Email"
                           class="w-full bg-slate-900/60 border border-slate-700 rounded-xl px-4 py-3 text-slate-50 text-sm placeholder-slate-500 focus:outline-none focus:border-brand transition" required />
                    <div class="relative">
                        <input type="password" id="loginPwd" name="password" placeholder="Password"
                               class="w-full bg-slate-900/60 border border-slate-700 rounded-xl px-4 py-3 pr-11 text-slate-50 text-sm placeholder-slate-500 focus:outline-none focus:border-brand transition" required />
                        <button type="button" onclick="togglePwd('loginPwd', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition">
                            <i class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                    <div class="text-right -mt-1">
                        <a href="/Auth/ForgotPassword" class="text-slate-500 hover:text-brand text-xs transition">Forgot password?</a>
                    </div>
                    <button type="submit"
                            class="w-full bg-brand hover:bg-brand-dark text-white font-semibold rounded-xl px-4 py-3 text-sm transition">
                        Sign In
                    </button>
                </form>
            }

            @if (!googleEnabled && !microsoftEnabled && !passwordEnabled)
            {
                <div class="text-center text-slate-400 text-sm py-4">
                    <i class="fa-solid fa-triangle-exclamation text-brand mr-2"></i>
                    No auth providers configured.<br />
                    Set <code class="text-brand">Auth__AdminEmail</code> and <code class="text-brand">Auth__AdminPassword</code> as Fly secrets.
                </div>
            }

        </div>

        <p class="text-center text-slate-400 text-xs mt-5">
            Don't have an account?
            <a href="/Auth/Register?returnUrl=@Uri.EscapeDataString(returnUrl)" class="text-brand hover:text-orange-700 font-medium">Sign up</a>
        </p>

    </div>

    <p class="text-center text-slate-600 text-xs mt-6">
        Candace Holder &copy; 2026 &mdash; Your data is private and secure
    </p>

</div>
<script src="~/js/toggle-password.js" asp-append-version="true"></script>
</body>
</html>
