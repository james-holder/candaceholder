@using CandaceHolder.Controllers
@{
    Layout = null;
    var recentLeads = ViewBag.RecentLeads as List<RecentLeadVm> ?? new();
}
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Candace Holder — Find Addresses</title>

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-config-app.js" asp-append-version="true"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Leaflet -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

    <!-- Google Maps Places — define callback BEFORE async script loads -->
    <script src="~/js/home-index-autocomplete.js" asp-append-version="true"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places&loading=async&callback=initAutocomplete" async></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="min-h-screen">

<!-- ══════════════════════════════════════════════════════════════
     HEADER / NAV
══════════════════════════════════════════════════════════════ -->
<header class="sticky top-0 z-50 bg-navy border-b border-slate-700/60 shadow-lg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 brand-logo rounded-lg flex items-center justify-center shadow">
                <i class="fa-solid fa-address-book text-slate-50 text-sm"></i>
            </div>
            <span class="text-lg font-bold tracking-tight">
                Candace <span class="brand-text">Holder</span>
            </span>
        </a>

        <!-- Nav links (desktop) -->
        <nav class="hidden lg:flex items-center gap-6 text-sm text-slate-400">
            <a href="/" class="text-slate-50">Search</a>
            <a href="/Leads/Saved" class="hover:text-brand transition-colors">Saved Leads</a>
            <a href="/Dashboard" class="hover:text-brand transition-colors">Dashboard</a>
            <a href="/Help" class="hover:text-brand transition-colors">
                <i class="fa-solid fa-circle-question mr-1 text-xs"></i>Help
            </a>
            @if (User.FindFirst("admin_role")?.Value is "admin" or "super_admin" ||
                 string.Equals(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "", Configuration["AdminEmail"], System.StringComparison.OrdinalIgnoreCase)) {
                <a href="/Admin" class="text-orange-600 hover:text-orange-700 transition-colors text-xs">
                    <i class="fa-solid fa-shield-halved mr-1"></i>Admin
                </a>
            }
            <span class="text-slate-600">|</span>
            @await Html.PartialAsync("_AccountMenu")
        </nav>

        <!-- Hamburger (mobile only) -->
        <button id="mobileMenuBtn" onclick="toggleMobileMenu()"
            class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-brand hover:bg-slate-700/60 transition-colors">
            <i id="mobileMenuIcon" class="fa-solid fa-bars text-lg"></i>
        </button>
    </div>

    <!-- Mobile nav drawer -->
    <div id="mobileMenu" class="hidden lg:hidden absolute top-full left-0 right-0 bg-navy border-t border-slate-700/60 shadow-2xl z-50 px-4 py-3 flex flex-col gap-1">
        <a href="/" class="flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-700/60 text-slate-50 font-semibold text-sm">
            <i class="fa-solid fa-magnifying-glass text-brand w-4 text-center text-xs"></i>Search
        </a>
        <a href="/Leads/Saved" class="flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:text-brand hover:bg-slate-700/60 transition-colors text-sm">
            <i class="fa-solid fa-bookmark w-4 text-center text-xs"></i>Saved Leads
        </a>
        <a href="/Dashboard" class="flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:text-brand hover:bg-slate-700/60 transition-colors text-sm">
            <i class="fa-solid fa-chart-bar w-4 text-center text-xs"></i>Dashboard
        </a>
        <a href="/Help" class="flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:text-brand hover:bg-slate-700/60 transition-colors text-sm">
            <i class="fa-solid fa-circle-question w-4 text-center text-xs"></i>Help
        </a>
        <div class="border-t border-slate-700/60 my-1"></div>
        @await Html.PartialAsync("_AccountMenuMobile")
    </div>
</header>

<!-- Toast notification -->
<div id="toast">
    <i id="toastIcon" class="fa-solid fa-circle-check"></i>
    <span id="toastMsg"></span>
</div>

<!-- ══════════════════════════════════════════════════════════════
     MAIN TAB BAR
══════════════════════════════════════════════════════════════ -->
<div id="mainTabBar" class="bg-slate-900/80 border-b border-slate-700/60 sticky top-16 z-40 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex">
        <button id="tabBtnSearch" onclick="switchMainTab('search')"
            class="flex items-center gap-2 px-5 py-3.5 text-sm font-semibold
                   border-b-2 border-brand text-slate-50 -mb-px transition-colors">
            <i class="fa-solid fa-magnifying-glass-location text-brand/80 text-xs"></i>
            Address Search
        </button>
        <button id="tabBtnMap" onclick="switchMainTab('map')"
            class="flex items-center gap-2 px-5 py-3.5 text-sm font-semibold
                   border-b-2 border-transparent text-slate-400 hover:text-slate-200 -mb-px transition-colors">
            <i class="fa-solid fa-draw-polygon text-xs"></i>
            Draw on Map
        </button>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     ADDRESS SEARCH PANEL  (search form + results)
══════════════════════════════════════════════════════════════ -->
<div id="searchPanel">

    <!-- Search form -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
        <div class="bg-slate-800/80 backdrop-blur rounded-2xl shadow-2xl border border-slate-700/60 p-6 sm:p-8">

            <!-- Mode toggle -->
            <div class="flex items-center gap-1 mb-4 bg-slate-900/60 rounded-xl p-1 w-fit border border-slate-700/60">
                <button id="modeNeighborhood" type="button"
                    class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-all
                           bg-brand text-white shadow">
                    <i class="fa-solid fa-circle-dot"></i>Radius
                </button>
                <button id="modeSingle" type="button"
                    class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-all
                           text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-crosshairs"></i>Single Address
                </button>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">

                <!-- Address input -->
                <div class="relative flex-1">
                    <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-location-dot text-slate-400"></i>
                    </div>
                    <input
                        id="addressInput"
                        type="text"
                        placeholder="123 Main St, Dallas, TX"
                        class="w-full pl-9 pr-4 py-3.5 rounded-xl bg-slate-900 border border-slate-600 text-slate-50 placeholder-slate-500
                               focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition"
                    />
                </div>

                <!-- Radius selector (hidden in single-address mode) -->
                <div id="radiusWrapper" class="relative">
                    <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-circle-dot text-slate-400 text-xs"></i>
                    </div>
                    <select
                        id="radiusSelect"
                        class="pl-8 pr-8 py-3.5 rounded-xl bg-slate-900 border border-slate-600 text-slate-50 appearance-none
                               focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition cursor-pointer"
                    >
                        <option value="0.1">0.1 mi</option>
                        <option value="0.25" selected>0.25 mi</option>
                        <option value="0.5">0.5 mi</option>
                        <option value="1">1 mi</option>
                        <option value="2">2 mi</option>
                    </select>
                    <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-chevron-down text-slate-400 text-xs"></i>
                    </div>
                </div>

                <!-- Submit button -->
                <button
                    id="scanBtn"
                    onclick="runScan()"
                    class="flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-brand hover:bg-brand-dark
                           text-white font-bold text-sm tracking-wide shadow-lg shadow-brand/30
                           transition-all active:scale-95 whitespace-nowrap"
                >
                    <span id="btnText">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i>Find Addresses
                    </span>
                </button>
            </div>

            <p class="mt-3 text-xs text-slate-500">
                Finds every address in the area. Save the ones you want, then skip trace them from
                <a href="/Leads/Saved" class="text-brand hover:text-orange-600">Saved Leads</a>.
            </p>

            <!-- Error message -->
            <div id="errorMsg" class="hidden mt-4 flex items-center gap-2 text-red-600 text-sm bg-red-400/10 border border-red-400/20 rounded-lg px-4 py-3">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span id="errorText">Something went wrong. Please try again.</span>
            </div>
        </div>
    </div>

    @if (recentLeads.Any())
    {
        <!-- ══════════════════════════════════════════════════════════
             CONTINUE  (recently saved leads)
        ══════════════════════════════════════════════════════════ -->
        <div id="continueWidget" class="max-w-3xl mx-auto px-4 sm:px-6 pb-10 -mt-2">
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-700/60 flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-50">
                        <i class="fa-solid fa-clock-rotate-left text-brand mr-2"></i>Continue
                    </h2>
                    <a href="/Leads/Saved" class="text-xs text-brand hover:text-orange-600 font-semibold">
                        View all <i class="fa-solid fa-arrow-right ml-1"></i>
                    </a>
                </div>
                <div class="divide-y divide-slate-700/60">
                    @foreach (var lead in recentLeads)
                    {
                        <a href="/Leads/@lead.Id" class="flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-slate-700/30 transition-colors">
                            <div class="min-w-0">
                                <p class="text-sm text-slate-200 truncate">@lead.Address</p>
                                <p class="text-xs text-slate-500">@lead.SavedAt.ToString("MMM d, yyyy")</p>
                            </div>
                            @if (lead.IsEnriched)
                            {
                                <span class="text-xs font-semibold text-green-600 shrink-0"><i class="fa-solid fa-circle-check mr-1"></i>Traced</span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold text-slate-500 shrink-0">Not traced</span>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div><!-- end #searchPanel -->

<!-- ══════════════════════════════════════════════════════════════
     DRAW ON MAP PANEL
══════════════════════════════════════════════════════════════ -->
<section id="mapPanel" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-4 flex flex-wrap items-center gap-3 bg-slate-800/60 rounded-2xl border border-slate-700/60 px-5 py-3.5">
        <!-- Jump to a place -->
        <div class="relative flex-1 min-w-[220px]">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                <i class="fa-solid fa-magnifying-glass text-slate-500 text-xs"></i>
            </div>
            <input id="mapJumpInput" type="text" placeholder="Go to a city, ZIP, or address…"
                class="w-full pl-8 pr-3 py-2 rounded-lg bg-slate-900 border border-slate-600 text-slate-50 text-sm placeholder-slate-500
                       focus:outline-none focus:ring-1 focus:ring-brand" />
        </div>
        <button onclick="jumpMapTo()"
            class="px-3 py-2 rounded-lg border border-slate-600 bg-slate-900 text-xs text-slate-300 hover:text-brand transition-colors">
            Go
        </button>

        <!-- Draw-a-rectangle area selection -->
        <button id="areaSelectBtn" onclick="toggleAreaSelect()"
            class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-600 bg-slate-900
                   text-xs font-semibold text-slate-300 hover:text-brand hover:border-brand/60 transition-colors">
            <i class="fa-solid fa-draw-polygon text-brand text-xs"></i>
            Select Area
        </button>
    </div>

    <p id="areaHint" class="mb-3 text-xs text-slate-500">
        Click <b class="text-slate-300">Select Area</b>, then click and drag a box on the map (up to ~5 miles across).
        Every address inside it is listed below the search box so you can save the ones you want.
    </p>

    <div class="rounded-2xl overflow-hidden border border-slate-700/60 shadow-xl" style="height: calc(100vh - 300px); min-height: 460px;">
        <div id="areaMap" class="w-full h-full"></div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════════
     RESULTS  (shared by Address Search and Draw on Map)
══════════════════════════════════════════════════════════════ -->
<section id="results" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- ── Summary bar ── -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
        <div class="flex-1 min-w-0">
            <h2 class="text-xl font-bold text-slate-50 truncate">
                <i class="fa-solid fa-map-pin text-brand mr-2"></i>
                <span id="centerLabel">Results</span>
            </h2>
        </div>
        <div class="flex flex-wrap gap-2">
            <div class="summary-badge flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-700 border border-slate-600 text-sm">
                <span class="text-slate-300 font-medium">Addresses:</span>
                <span id="countTotal" class="text-slate-50 font-bold">0</span>
            </div>
        </div>
    </div>

    <!-- ── Toolbar: filter + sort + actions ── -->
    <div class="mb-5 flex flex-wrap items-center gap-3">

        <!-- Text filter -->
        <div class="relative">
            <div class="absolute inset-y-0 left-2.5 flex items-center pointer-events-none">
                <i class="fa-solid fa-filter text-slate-500 text-xs"></i>
            </div>
            <input id="filterInput" type="text" placeholder="Filter (e.g. street name)"
                class="pl-7 pr-3 py-2 text-xs rounded-xl bg-slate-800 border border-slate-700 text-slate-200 placeholder-slate-500
                       focus:outline-none focus:ring-1 focus:ring-brand w-52" />
        </div>

        <!-- Sort -->
        <div class="relative">
            <div class="absolute inset-y-0 left-2.5 flex items-center pointer-events-none">
                <i class="fa-solid fa-arrow-up-wide-short text-slate-500 text-xs"></i>
            </div>
            <select id="sortSelect"
                class="pl-7 pr-6 py-2 text-xs rounded-xl bg-slate-800 border border-slate-700 text-slate-300
                       appearance-none focus:outline-none focus:ring-1 focus:ring-brand cursor-pointer">
                <option value="distance">Sort: Closest first</option>
                <option value="address">Sort: Address</option>
            </select>
        </div>

        <div class="flex-1"></div>

        <button onclick="exportCSV()"
            class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-700 hover:bg-slate-600
                   border border-slate-600 text-xs font-semibold text-slate-200 transition shadow">
            <i class="fa-solid fa-file-csv text-brand"></i>Export CSV
        </button>

        <button id="selectAllBtn" onclick="toggleSelectAll()"
            class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-700 hover:bg-slate-600
                   border border-slate-600 text-xs font-semibold text-slate-200 transition shadow">
            <i class="fa-regular fa-square-check text-brand"></i>
            <span id="selectAllLabel">Select All</span>
        </button>

        <button id="saveSelectedBtn" onclick="saveSelected()"
            class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand hover:bg-brand-dark
                   text-white text-xs font-semibold transition shadow">
            <i class="fa-solid fa-bookmark mr-1"></i>
            Save Selected (<span id="selectedCount">0</span>)
        </button>
    </div>

    <!-- Two-col: cards + map -->
    <div class="flex flex-col lg:flex-row gap-6">
        <div id="cardList" class="lg:w-96 xl:w-[420px] flex-shrink-0 overflow-y-auto max-h-[calc(100vh-220px)] pr-1 space-y-0">
        </div>
        <div class="flex-1 rounded-2xl overflow-hidden border border-slate-700/60 shadow-xl min-h-[400px] lg:min-h-0"
             style="height: calc(100vh - 220px); min-height: 420px;">
            <div id="map" class="w-full h-full"></div>
        </div>
    </div>
</section>

<footer class="mt-12 border-t border-slate-700/60 bg-slate-900/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
        <div class="flex items-center gap-2">
            <div class="w-5 h-5 brand-logo rounded flex items-center justify-center">
                <i class="fa-solid fa-address-book text-slate-50 text-xs"></i>
            </div>
            <span>Candace Holder &copy; 2026</span>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
<script>window.MAPTILER_KEY = '@ViewBag.MapTilerApiKey';</script>
<script src="~/js/area-map.js" asp-append-version="true"></script>
</body>
</html>
