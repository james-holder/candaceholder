@using CandaceHolder.Controllers
@{
    Layout = null;
    var month     = (DateTime)ViewBag.Month;
    var lines     = ViewBag.Lines as List<AdminController.InvoiceLine> ?? new();
    var rate      = (decimal)ViewBag.Rate;
    var totals    = (AdminController.InvoiceTotals)ViewBag.Totals;
    var total     = totals.Total;
    var billTo    = ViewBag.BillTo   as string ?? "";
    var billFrom  = ViewBag.BillFrom as string ?? "";
    var payNote   = ViewBag.PayNote  as string ?? "";
    var invoiceNo = ViewBag.InvoiceNo as string ?? "";
    var thisMonth = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice @invoiceNo — Candace Holder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-config-app.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        [contenteditable]:hover { outline: 1px dashed #e9c6dc; outline-offset: 3px; border-radius: 4px; }
        [contenteditable]:focus { outline: 2px solid #e11d74; outline-offset: 3px; border-radius: 4px; }
        [contenteditable]:empty::before { content: attr(data-placeholder); color: #b3aec2; }
        @@media print {
            body { background: #fff !important; background-image: none !important; }
            .no-print { display: none !important; }
            .invoice-sheet { box-shadow: none !important; border: 0 !important; margin: 0 !important; max-width: none !important; }
            [contenteditable] { outline: none !important; }
            [contenteditable]:empty::before { content: ''; }
        }
    </style>
</head>
<body class="min-h-screen">

<!-- Toolbar (hidden when printing) -->
<div class="no-print max-w-3xl mx-auto px-4 pt-6 flex flex-wrap items-center gap-2">
    <a href="/Admin" class="text-xs text-slate-500 hover:text-brand mr-auto">
        <i class="fa-solid fa-arrow-left mr-1"></i>Admin
    </a>
    <a href="/Admin/Invoice?month=@month.AddMonths(-1).ToString("yyyy-MM")"
       class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs font-semibold text-slate-300">
        <i class="fa-solid fa-chevron-left"></i>
    </a>
    <span class="text-sm font-bold text-slate-50 px-1">@month.ToString("MMMM yyyy")</span>
    @if (month < thisMonth)
    {
        <a href="/Admin/Invoice?month=@month.AddMonths(1).ToString("yyyy-MM")"
           class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs font-semibold text-slate-300">
            <i class="fa-solid fa-chevron-right"></i>
        </a>
    }
    <a href="/Admin/Invoice/Csv?month=@month.ToString("yyyy-MM")"
       class="ml-2 px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs font-semibold text-slate-300">
        <i class="fa-solid fa-file-csv text-teal-600 mr-1"></i>CSV
    </a>
    <button onclick="window.print()"
            class="px-4 py-1.5 rounded-lg bg-brand text-white text-xs font-semibold">
        <i class="fa-solid fa-print mr-1"></i>Print / Save PDF
    </button>
</div>
<p class="no-print max-w-3xl mx-auto px-4 mt-2 text-xs text-slate-500">
    Click any dashed text to edit it before printing. Defaults come from the <code>Billing</code> settings.
</p>
@if (totals.Warning != null)
{
    <p class="no-print max-w-3xl mx-auto px-4 mt-2 text-xs font-semibold text-orange-700">
        <i class="fa-solid fa-triangle-exclamation mr-1"></i>@totals.Warning
    </p>
}

<!-- Invoice -->
<div class="invoice-sheet max-w-3xl mx-auto my-6 bg-white rounded-2xl shadow-xl border border-slate-700 overflow-hidden">
    <div class="h-2" style="background: var(--rainbow)"></div>
    <div class="p-8 sm:p-10">

        <div class="flex flex-wrap items-start justify-between gap-6 mb-8">
            <div>
                <h1 class="text-3xl font-black text-slate-50 tracking-tight">INVOICE</h1>
                <p class="text-sm text-slate-400 mt-1">No. <span contenteditable="true">@invoiceNo</span></p>
                <p class="text-sm text-slate-400">Issued @DateTime.Now.ToString("MMMM d, yyyy")</p>
                <p class="text-sm text-slate-400">Period: @month.ToString("MMMM 1") – @month.AddMonths(1).AddDays(-1).ToString("MMMM d, yyyy")</p>
            </div>
            <div class="text-right">
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">From</p>
                <p class="text-sm font-semibold text-slate-50 whitespace-pre-line" contenteditable="true" data-placeholder="Your name / address">@billFrom</p>
            </div>
        </div>

        <div class="mb-8">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Bill to</p>
            <p class="text-sm font-semibold text-slate-50 whitespace-pre-line" contenteditable="true" data-placeholder="Company name / address">@billTo</p>
        </div>

        <table class="w-full text-sm mb-6">
            <thead>
                <tr class="border-b-2 border-slate-700 text-left text-xs uppercase tracking-wider text-slate-500">
                    <th class="py-2">Description</th>
                    <th class="py-2 text-right">Qty</th>
                    <th class="py-2 text-right">Rate</th>
                    <th class="py-2 text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-slate-700">
                    <td class="py-3 text-slate-200">
                        Skip-trace lookups (matched) — BatchData, at cost
                        <span class="block text-xs text-slate-500">@month.ToString("MMMM yyyy") · no-match lookups aren't charged</span>
                    </td>
                    <td class="py-3 text-right text-slate-200">@lines.Count</td>
                    <td class="py-3 text-right text-slate-200">@rate.ToString("C2")</td>
                    <td class="py-3 text-right font-semibold text-slate-50">@totals.Subtotal.ToString("C2")</td>
                </tr>
                @foreach (var extra in totals.Extras)
                {
                    <tr class="border-b border-slate-700">
                        <td class="py-3 text-slate-200">
                            @extra.Label
                            <span class="block text-xs text-slate-500">@extra.Percent.ToString("0.##")% of the lookup cost — charged by BatchData when the wallet is funded</span>
                        </td>
                        <td class="py-3"></td>
                        <td class="py-3 text-right text-slate-200">@extra.Percent.ToString("0.##")%</td>
                        <td class="py-3 text-right font-semibold text-slate-50">@extra.Amount.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="flex justify-end mb-10">
            <div class="w-60">
                <div class="flex justify-between items-center rounded-xl px-4 py-3" style="background:#fff0f7">
                    <span class="text-sm font-bold text-slate-200">Total due</span>
                    <span class="text-2xl font-black text-brand">@total.ToString("C2")</span>
                </div>
            </div>
        </div>

        @if (totals.Source != null)
        {
            <p class="text-xs text-slate-500 -mt-6 mb-8 text-right">@totals.Source</p>
        }

        <div class="mb-10">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Payment</p>
            <p class="text-sm text-slate-300 whitespace-pre-line" contenteditable="true" data-placeholder="How to pay — e.g. Zelle to …, or check payable to …">@payNote</p>
        </div>

        <!-- Detail -->
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Detail — @lines.Count matched lookup@(lines.Count == 1 ? "" : "s")</h2>
        @if (lines.Any())
        {
            <table class="w-full text-xs">
                <thead>
                    <tr class="border-b border-slate-700 text-left text-slate-500">
                        <th class="py-1.5 pr-3">Date</th>
                        <th class="py-1.5 pr-3">Address</th>
                        <th class="py-1.5 pr-3">Run by</th>
                        <th class="py-1.5 text-right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in lines)
                    {
                        <tr class="border-b border-slate-700/60">
                            <td class="py-1.5 pr-3 text-slate-400 whitespace-nowrap">@l.CreatedAt.ToString("MMM d")</td>
                            <td class="py-1.5 pr-3 text-slate-300">@l.Address</td>
                            <td class="py-1.5 pr-3 text-slate-400">@l.RunBy</td>
                            <td class="py-1.5 text-right text-slate-300">@rate.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-sm text-slate-500 italic">No matched skip traces this month.</p>
        }
    </div>
</div>

</body>
</html>
