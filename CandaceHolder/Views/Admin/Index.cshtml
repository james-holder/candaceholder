@using CandaceHolder.Controllers
@{
    Layout = null;
    var totalUsers  = (int)(ViewBag.TotalUsers  ?? 0);
    var totalLeads  = (int)(ViewBag.TotalLeads  ?? 0);
    var isSuperAdmin = ViewBag.IsSuperAdmin is true;
    var wallet       = ViewBag.WalletBalance as CandaceHolder.Services.RealDataService.WalletBalance;
    var walletError  = ViewBag.WalletError as string;
    var walletTraces = ViewBag.WalletTraces as int?;
    var walletLow    = ViewBag.WalletLow is true;
    var emailReady   = ViewBag.EmailConfigured is true;
    var totalEnrich  = (int)(ViewBag.TotalEnrich ?? 0);
    var enrichMonth  = (int)(ViewBag.EnrichMonth ?? 0);
    var leadsMonth   = (int)(ViewBag.LeadsMonth  ?? 0);
    var users       = ViewBag.Users as List<AdminController.UserRow> ?? new();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — Candace Holder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-config-app.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rich-editor.css" asp-append-version="true" />
</head>
<body class="min-h-screen">

<!-- Header -->
<header class="sticky top-0 z-50 bg-navy border-b border-slate-700/60 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
            <div class="w-8 h-8 brand-logo rounded-lg flex items-center justify-center shadow">
                <i class="fa-solid fa-address-book text-slate-50 text-sm"></i>
            </div>
            <span class="text-lg font-extrabold tracking-tight">Candace <span class="brand-text">Holder</span></span>
        </a>
        <nav class="hidden lg:flex items-center gap-6 text-sm text-slate-400">
            <a href="/" class="hover:text-brand transition-colors">Search</a>
            <a href="/Leads/Saved" class="hover:text-brand transition-colors">Saved Leads</a>
            <a href="/Dashboard" class="hover:text-brand transition-colors">Dashboard</a>
            <a href="/Admin" class="text-orange-600 font-semibold">
                <i class="fa-solid fa-shield-halved mr-1 text-xs"></i>Admin
            </a>
            <span class="text-slate-600">|</span>
            @await Html.PartialAsync("_AccountMenu")
        </nav>
    </div>
</header>

<!-- Page hero -->
<div class="border-b border-slate-700/40 hero-band">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <h1 class="text-2xl font-extrabold text-slate-50">
            <i class="fa-solid fa-shield-halved text-brand mr-2"></i>Admin Dashboard
        </h1>
        <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-slate-400 text-sm mt-0.5">Usage across all users</p>
            <a href="/Admin/Invoice" class="px-4 py-2 rounded-xl bg-brand text-white text-xs font-semibold shadow">
                <i class="fa-solid fa-file-invoice-dollar mr-1.5"></i>Monthly usage invoice
            </a>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    @if (TempData["AdminOk"] != null)
    {
        <div class="mb-6 rounded-xl border border-green-500/30 bg-green-500/10 text-green-700 px-4 py-3 text-sm">
            <i class="fa-solid fa-circle-check mr-2"></i>@TempData["AdminOk"]
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="mb-6 rounded-xl border border-red-500/30 bg-red-500/10 text-red-700 px-4 py-3 text-sm">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i>@TempData["AdminError"]
        </div>
    }

    <!-- BatchData wallet + email status -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="rounded-2xl border p-5 @(walletLow ? "border-red-300 bg-red-50" : "border-slate-700 bg-white")">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">
                <i class="fa-solid fa-wallet text-teal-600 mr-1.5"></i>BatchData wallet
            </p>
            @if (wallet != null)
            {
                <p class="text-3xl font-black @(walletLow ? "text-red-600" : "text-slate-50")">@wallet.Balance.ToString("C2")</p>
                <p class="text-xs text-slate-500 mt-1">
                    ≈ @(walletTraces?.ToString("N0") ?? "—") matched skip traces left
                    @if (wallet.AsOf != null) { <span>· as of @wallet.AsOf.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span> }
                </p>
                @if (walletLow)
                {
                    <p class="text-xs font-semibold text-red-700 mt-2">
                        <i class="fa-solid fa-triangle-exclamation mr-1"></i>Balance is low — add funds at
                        <a href="https://app.batchdata.com" target="_blank" rel="noopener" class="underline">app.batchdata.com</a>
                        before skip traces start failing.
                    </p>
                }
            }
            else if (walletError != null)
            {
                <p class="text-sm font-semibold text-red-600"><i class="fa-solid fa-circle-exclamation mr-1"></i>@walletError</p>
            }
            else
            {
                <p class="text-sm text-slate-500">No BatchData key set yet (<code>BatchData__ApiKey</code>).</p>
            }
        </div>

        <div class="rounded-2xl border border-slate-700 bg-white p-5 flex items-center justify-between gap-4">
            <div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">
                    <i class="fa-solid fa-envelope text-brand mr-1.5"></i>Email
                </p>
                @if (emailReady)
                {
                    <p class="text-sm font-semibold text-green-700"><i class="fa-solid fa-circle-check mr-1"></i>Set up</p>
                    <p class="text-xs text-slate-500 mt-1">Password resets, team invites and the email buttons below will send.</p>
                }
                else
                {
                    <p class="text-sm font-semibold text-orange-600"><i class="fa-solid fa-circle-exclamation mr-1"></i>Not set up</p>
                    <p class="text-xs text-slate-500 mt-1">Emails (resets, invites, messages to users) won't send until this is set up.</p>
                }
            </div>
            @if (isSuperAdmin)
            {
                <a href="/Admin/Email" class="shrink-0 px-4 py-2 rounded-xl bg-slate-700 hover:bg-slate-600 text-xs font-semibold text-slate-200">
                    <i class="fa-solid fa-gear mr-1"></i>Email settings
                </a>
            }
        </div>
    </div>

    <!-- Platform stats -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
        <div class="stat-card">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Users</p>
            <p class="text-3xl font-extrabold text-slate-50">@totalUsers</p>
            <p class="text-xs text-slate-500 mt-1">total registered</p>
        </div>
        <div class="stat-card">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Total Leads</p>
            <p class="text-3xl font-extrabold text-slate-50">@totalLeads</p>
            <p class="text-xs text-slate-500 mt-1">across all users</p>
        </div>
        <div class="stat-card">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Leads / Month</p>
            <p class="text-3xl font-extrabold text-brand">@leadsMonth</p>
            <p class="text-xs text-slate-500 mt-1">current month</p>
        </div>
        <div class="stat-card">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Skip Traces</p>
            <p class="text-3xl font-extrabold text-slate-50">@totalEnrich</p>
            <p class="text-xs text-slate-500 mt-1">all time</p>
        </div>
        <div class="stat-card">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Traces / Month</p>
            <p class="text-3xl font-extrabold text-brand">@enrichMonth</p>
            <p class="text-xs text-slate-500 mt-1">current month</p>
        </div>
    </div>

    @{
        var emailableCount = users.Count(u => !string.IsNullOrEmpty(u.Email));
    }

    <!-- Users table -->
    <div class="rounded-2xl border border-slate-700/60 overflow-hidden shadow-xl bg-slate-800/40 mb-6">
        <div class="px-5 py-4 border-b border-slate-700/60 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-50">
                <i class="fa-solid fa-users text-brand mr-2"></i>Users
                <span class="ml-2 text-xs font-normal text-slate-400">(@users.Count total)</span>
            </h2>
            @if (emailableCount > 0)
            {
                <button type="button" onclick="openBroadcastEmailModal(@emailableCount)"
                        class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold">
                    <i class="fa-solid fa-bullhorn mr-1.5 text-brand"></i>Email All
                </button>
            }
        </div>
        <div class="overflow-x-auto">
            <table class="admin-users-table w-full border-collapse">
                <thead>
                    <tr>
                        <th class="text-left">User</th>
                        <th class="text-left">Leads</th>
                        <th class="text-left">Skip Traces</th>
                        <th class="text-left">Last Lead</th>
                        <th class="text-left">Joined</th>
                        @if (isSuperAdmin) { <th class="text-left">Admin Role</th> }
                    </tr>
                </thead>
                <tbody>
                    @if (users.Any())
                    {
                        @foreach (var u in users)
                        {
                            var joined   = u.CreatedAt.ToString("yyyy-MM-dd");
                            var lastLead = u.LastLeadAt.HasValue ? u.LastLeadAt.Value.ToString("yyyy-MM-dd") : "—";
                            <tr>
                                <td>
                                    <div class="flex items-start gap-2">
                                        <div>
                                            <p class="font-semibold text-slate-50 text-xs">
                                                @(string.IsNullOrEmpty(u.DisplayName) ? "—" : u.DisplayName)
                                                @if (u.Role == "super_admin")
                                                {
                                                    <span class="ml-1 px-1.5 py-0.5 rounded bg-brand/20 text-brand text-[10px] font-bold uppercase tracking-wide">Super Admin</span>
                                                }
                                                else if (u.Role == "admin")
                                                {
                                                    <span class="ml-1 px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-700 text-[10px] font-bold uppercase tracking-wide">Admin</span>
                                                }
                                            </p>
                                            <p class="text-slate-500 text-xs">@u.Email</p>
                                        </div>
                                        @if (!string.IsNullOrEmpty(u.Email))
                                        {
                                            <button type="button" onclick="openEmailModal(this)"
                                                    data-id="@u.Id" data-email="@u.Email" data-name="@u.DisplayName"
                                                    class="mt-0.5 text-slate-500 hover:text-brand transition-colors shrink-0" title="Email this user">
                                                <i class="fa-solid fa-envelope text-xs"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td class="font-semibold text-slate-50">@u.LeadCount</td>
                                <td class="font-semibold text-slate-50">@u.EnrichCount</td>
                                <td class="text-slate-400 whitespace-nowrap">@lastLead</td>
                                <td class="text-slate-400 whitespace-nowrap">@joined</td>
                                @if (isSuperAdmin)
                                {
                                    <td class="whitespace-nowrap">
                                        @if (u.Role == "super_admin")
                                        {
                                            <span class="text-slate-600 text-xs">—</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/Admin/Users/@u.Id/Role" class="inline">
                                                @Html.AntiForgeryToken()
                                                @if (u.Role == "admin")
                                                {
                                                    <button type="submit" name="role" value="user" class="px-2.5 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs">Remove admin</button>
                                                }
                                                else
                                                {
                                                    <button type="submit" name="role" value="admin" class="px-2.5 py-1.5 rounded-lg bg-blue-600/80 hover:bg-blue-600 text-slate-50 text-xs">Make admin</button>
                                                }
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-slate-500 py-10 text-sm">
                                <i class="fa-solid fa-users text-3xl text-slate-700 block mb-2"></i>
                                No users yet
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Email user modal -->
<div id="emailModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4" style="background: rgba(0,0,0,0.6);">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[94vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700">
            <h3 class="text-slate-50 font-bold text-sm">
                <i class="fa-solid fa-envelope text-brand mr-2"></i>Email <span id="emailModalName" class="text-slate-400 font-normal"></span>
            </h3>
            <button type="button" onclick="closeEmailModal()" class="text-slate-500 hover:text-brand transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form id="emailModalForm" method="post" class="p-5 space-y-3" onsubmit="return beforeSendAdminEmail()">
            @Html.AntiForgeryToken()
            <input type="hidden" name="body" id="emailBodyHtml" />
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-xs text-slate-400">Template</label>
                    <button type="button" onclick="openManageTemplates()" class="text-xs font-semibold text-brand hover:underline">
                        <i class="fa-solid fa-pen-to-square mr-1"></i>Manage templates
                    </button>
                </div>
                <select id="emailTemplateSelect" onchange="applyEmailTemplate()"
                        class="w-full bg-slate-900 border border-slate-600 rounded-lg text-sm text-slate-50 px-3 py-2 focus:outline-none focus:border-brand">
                    <option value="">Custom (blank)</option>
                </select>
            </div>
            <div>
                <label class="block text-xs text-slate-400 mb-1">To</label>
                <input id="emailModalTo" type="text" disabled
                       class="w-full bg-slate-900/60 border border-slate-700 rounded-lg text-sm text-slate-400 px-3 py-2" />
            </div>
            <div>
                <label class="block text-xs text-slate-400 mb-1">Subject</label>
                <input id="emailSubject" name="subject" type="text" required
                       class="w-full bg-slate-900 border border-slate-600 rounded-lg text-sm text-slate-50 px-3 py-2 focus:outline-none focus:border-brand" />
            </div>
            <div>
                <label class="block text-xs text-slate-400 mb-1">Message</label>
                <div id="adminMsgEditor" class="rounded-xl border border-slate-600 overflow-hidden focus-within:border-brand bg-white">
                    <partial name="_RichToolbar" />
                    <div class="rt-body rt-short" contenteditable="true" spellcheck="true" data-placeholder="Write your message…"></div>
                </div>
                <p class="text-xs text-slate-500 mt-1">
                    Edit freely before sending. Codes like <code class="bg-slate-900 px-1 rounded">{{first_name}}</code> and
                    <code class="bg-slate-900 px-1 rounded">{{signature}}</code> are filled in for each person when it's sent.
                </p>
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeEmailModal()" class="px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs">Cancel</button>
                <button type="submit" class="px-4 py-2 rounded-lg bg-brand hover:bg-brand-dark text-white text-xs font-semibold">
                    <i class="fa-solid fa-paper-plane mr-1"></i>Send
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Manage admin templates -->
<div id="manageModal" class="hidden fixed inset-0 z-[65] flex items-center justify-center p-4" style="background: rgba(0,0,0,0.6);">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl w-full max-w-3xl max-h-[94vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700">
            <div>
                <h3 class="text-slate-50 font-bold text-sm"><i class="fa-solid fa-pen-to-square text-brand mr-2"></i>Admin email templates</h3>
                <p class="text-xs text-slate-500 mt-0.5">For messages to your team members. Lead templates are on the
                    <a href="/Email/Templates" class="text-brand font-semibold hover:underline">Email Templates</a> page.</p>
            </div>
            <button type="button" onclick="closeManageTemplates()" class="text-slate-500 hover:text-brand transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="p-5 grid grid-cols-1 md:grid-cols-[200px_1fr] gap-5">
            <div>
                <button type="button" onclick="newAdminTemplate()" class="w-full mb-2 flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-brand text-white text-xs font-semibold shadow">
                    <i class="fa-solid fa-plus"></i>New template
                </button>
                <div id="adminTplList" class="space-y-1.5"></div>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Template name</label>
                    <input id="atName" maxlength="100" placeholder="e.g. Welcome to the team"
                           class="w-full bg-slate-900 border border-slate-600 rounded-lg text-sm text-slate-50 px-3 py-2 focus:outline-none focus:border-brand" />
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Subject</label>
                    <input id="atSubject" maxlength="200" placeholder="e.g. Checking in"
                           class="w-full bg-slate-900 border border-slate-600 rounded-lg text-sm text-slate-50 px-3 py-2 focus:outline-none focus:border-brand" />
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Message</label>
                    <div id="adminTplEditor" class="rounded-xl border border-slate-600 overflow-hidden focus-within:border-brand bg-white">
                        <partial name="_RichToolbar" />
                        <div class="rt-body rt-short" contenteditable="true" spellcheck="true" data-placeholder="Hi {{first_name|there}},"></div>
                    </div>
                    <div class="flex flex-wrap gap-1.5 mt-2">
                        @foreach (var (v, d) in new[] { ("first_name", "Their first name"), ("full_name", "Their full name"), ("email", "Their email address"), ("sender_name", "Your name"), ("company_name", "Company name") })
                        {
                            <button type="button" class="admin-var-chip px-2 py-1 rounded-lg bg-pink-50 border border-pink-200 text-pink-700 text-xs font-semibold hover:bg-pink-100"
                                    data-var="@v" title="@d">{{@v}}</button>
                        }
                    </div>
                </div>
                <div class="flex items-center gap-2 pt-1">
                    <button type="button" onclick="saveAdminTemplate()" id="atSaveBtn" class="px-5 py-2 rounded-xl bg-brand text-white text-sm font-bold shadow">
                        <i class="fa-solid fa-floppy-disk mr-1.5"></i>Save
                    </button>
                    <button type="button" onclick="deleteAdminTemplate()" id="atDeleteBtn" class="hidden px-4 py-2 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-semibold">
                        <i class="fa-solid fa-trash mr-1"></i>Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Shown when a picture in an editor is clicked -->
<div id="imgMenu" class="hidden fixed z-[80] flex items-center gap-1 bg-white border border-pink-200 rounded-xl shadow-lg px-1.5 py-1 text-xs font-semibold">
    <button type="button" class="tb-btn tb-wide" data-img-size="small">Small</button>
    <button type="button" class="tb-btn tb-wide" data-img-size="medium">Medium</button>
    <button type="button" class="tb-btn tb-wide" data-img-size="full">Full width</button>
    <span class="tb-sep"></span>
    <button type="button" class="tb-btn tb-wide text-red-600" data-img-size="remove"><i class="fa-solid fa-trash mr-1"></i>Remove</button>
</div>

<div id="adminToast" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-[90] px-4 py-2.5 rounded-xl shadow-lg text-sm font-semibold"></div>

<script src="~/js/rich-editor.js" asp-append-version="true"></script>
<script src="~/js/admin-index.js" asp-append-version="true"></script>

</body>
</html>